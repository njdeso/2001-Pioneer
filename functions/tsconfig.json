{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@asm/shared": [
        "../packages/shared/src/index.ts"
      ],
      "@asm/shared/pdf": [
        "../packages/shared/src/pdfText.ts"
      ],
      "@asm/shared/excel": [
        "../packages/shared/src/excelRead.ts"
      ],
      "@asm/shared/excel-write": [
        "../packages/shared/src/excelWrite.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
