# Copy to apps/admin/.env.local (local) and set the same names in Netlify → Site settings → Environment variables.
# These identify your Firebase web app. They are not secrets, but keep real values out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=us-central1

# Local development against the Firebase emulators (true/false)
VITE_USE_EMULATORS=false

# ---- Server-side only (Cloud Functions). NEVER put these in apps/admin/.env* or Netlify. ----
# Set with:  firebase functions:secrets:set ANTHROPIC_API_KEY   (needed from Phase 3)
# Owner email(s) for first-run admin access, set when you deploy functions:
#   functions/.env  →  OWNER_EMAILS=you@example.com
