# Copy to apps/admin/.env.dev.local and fill in the pioneer-2001-dev web app config.
# Used by:  npm run dev:pioneer-2001-dev   (vite --mode dev). Never used by the production build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pioneer-2001-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pioneer-2001-dev
VITE_FIREBASE_STORAGE_BUCKET=pioneer-2001-dev.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=us-central1
VITE_USE_EMULATORS=false
