# Copy to apps/admin/.env.dev.local and fill in the pioneer-dev web app config.
# Used by:  npm run dev:pioneer-dev   (vite --mode dev). Never used by the production build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pioneer-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pioneer-dev
VITE_FIREBASE_STORAGE_BUCKET=pioneer-dev.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=us-east4
VITE_USE_EMULATORS=false
