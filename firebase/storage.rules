rules_version = '2';

// Agency Sale Manager — Cloud Storage rules.
// The browser can do exactly one thing: an admin uploads a NEW commission statement to the
// one-time path issued by registerStatementUpload (incoming/{their uid}/{statementId}/upload.{ext}),
// limited to PDF / XLSX / CSV and 20 MB. Nothing can be read, listed, overwritten or deleted
// from the browser. Originals are moved by Cloud Functions to statements/{id}/ and viewed
// only through short-lived signed URLs.

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.get('role', '') == 'admin';
    }
    function allowedType(ext) {
      return (ext == 'pdf' && request.resource.contentType == 'application/pdf')
        || (ext == 'xlsx' && request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet|application/vnd\\.ms-excel\\.sheet\\.macroEnabled\\.12|application/octet-stream'))
        || (ext == 'csv' && request.resource.contentType.matches('text/csv|text/plain|application/vnd\\.ms-excel|application/csv|application/octet-stream'));
    }

    match /incoming/{uid}/{statementId}/{fileName} {
      // resource == null: the path must be empty, so an upload can never replace an earlier one.
      allow create: if isAdmin()
        && resource == null
        && request.auth.uid == uid
        && fileName.matches('upload\\.(pdf|xlsx|csv)')
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && allowedType(fileName.split('\\.')[1]);
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
